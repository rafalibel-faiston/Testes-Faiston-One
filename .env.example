# Local: deixe em branco pra usar SQLite (arquivo fluxoc.db) automaticamente.
# Railway: a variável DATABASE_URL já vem pronta quando você adiciona o plugin Postgres
# ao projeto — não precisa copiar nada, só garantir que o serviço web está com essa env var.
DATABASE_URL=

# Servidor MCP (Claude/Cowork) — ver README, seção "Conectar no Claude/Cowork via MCP".
# MCP_TOKEN é a "senha" pedida na telinha de login ao vincular o conector.
# Gere um valor aleatório forte, ex.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=

# URL pública do app, sem barra no final (usada como issuer/resource do OAuth do MCP).
# Local: pode deixar em branco, cai pro http://127.0.0.1:8000.
# Railway: coloque o domínio gerado, ex. https://web-production-xxxx.up.railway.app
PUBLIC_BASE_URL=
